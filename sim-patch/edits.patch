-  min-width: 2.1rem;
-  min-height: 2.1rem;
-  place-items: center;
-  border: 1px solid rgba(105, 247, 255, 0.28);
-  color: var(--cyan);
+.selection-actions button {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  padding: 7px 10px;
+  font-size: 0.7rem;
+}
+
+.selection-action-pin {
+  justify-content: center;
+  min-width: 38px;
+  padding-inline: 8px;
+}
+
+.selection-action-pin--active {
+  border-color: rgba(183, 255, 74, 0.42);
+  background: rgba(183, 255, 74, 0.1);
+  color: var(--phosphor);
+}
+
+.pin-glyph {
+  width: 1rem;
+  height: 1rem;
+  display: block;
+  fill: currentColor;
+}
+
+/* Readings: a wrapping row of label/value pairs that never split mid-pair. */
+.radio-summary {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 2px 14px;
+  margin: 0;
+  min-width: 0;
+}
+
+.radio-summary div {
+  display: flex;
+  align-items: baseline;
+  gap: 5px;
+  border: 0;
+  padding: 0;
+  background: none;
+  white-space: nowrap;
+}
+
+.radio-summary dt {
+  color: var(--muted);
+  font-size: 0.66rem;
+  font-weight: 900;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+}
+
+.radio-summary dd {
+  margin: 0;
+  color: var(--phosphor);
   font-size: 0.82rem;
+  font-weight: 900;
 }
 
