+function createBridgeHarness() {
+  const handlers = new Set<(command: BridgeCommand) => void | Promise<void>>();
+  const displayResponses: Array<{ id: string | undefined; displays: Record<string, number[]> }> = [];
+  const ackedIds: Array<string | undefined> = [];
+  const positionResponses: Array<{
+    id: string | undefined;
+    positions: Array<{ kind: 'device' | 'source'; id: string; x: number; y: number }>;
+  }> = [];
+  const errorResponses: Array<{ id: string | undefined; message: string }> = [];
+  const bridge: SimLearnerBridge = {
+    onCommand(handler) {
+      handlers.add(handler);
+      return () => { handlers.delete(handler); };
+    },
+    sendBundle() {},
+    sendError(id, error) {
+      errorResponses.push({
+        id,
+        message: error instanceof Error ? error.message : String(error),
+      });
+    },
+    sendDisplayState(id, displays) {
+      displayResponses.push({ id, displays });
+    },
+    sendAck(id) {
+      ackedIds.push(id);
+    },
+    sendNodePositions(id, positions) {
+      positionResponses.push({ id, positions });
+    },
+  };
+
+  return {
+    bridge,
+    displayResponses,
+    ackedIds,
+    positionResponses,
+    async dispatch(command: BridgeCommand) {
+      await Promise.all([...handlers].map((handler) => handler(command)));
+    },
+  };
+}
