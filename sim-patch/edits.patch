+  event: SimulationState['radioEvents'][number],
+  deviceId: DeviceId,
+  displayNames: Map<DeviceId, string>,
+): ScopedRadioEvent | null {
+  const senderName = displayNames.get(event.senderId) ?? defaultDeviceNameForId(event.senderId);
+  const channelMeta = `group ${event.group} · channel ${event.channel}`;
+  if (event.senderId === deviceId) {
+    return {
+      id: event.id,
+      title: 'Sent',
+      meta: `${event.recipients.length} received / ${event.blockedTargets.length} blocked · ${channelMeta}`,
+      payload: formatRadioInspectorPayload(event.data, event.payloadRedacted === true),
+    };
+  }
+  if (event.receivedPackets.some((packet) => packet.deviceId === deviceId)) {
+    return {
+      id: event.id,
+      title: `Received from ${senderName}`,
+      meta: channelMeta,
+      payload: formatRadioInspectorPayload(event.data, event.payloadRedacted === true),
+    };
